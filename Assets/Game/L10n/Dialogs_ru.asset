  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogs_ru
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: ru
  m_SharedData: {fileID: 11400000, guid: 58070936bfb01de4f9cfb75929166653, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 16244863356928
    m_Localized: "\u0420\u0438\u043A\u043A\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 23575386542526464
    m_Localized: "\u042D\u0439, \u043F\u0443\u0442\u0435\u0448\u0435\u0448\u0442\u0432\u0435\u043D\u043D\u0438\u0447\u0435\u043A...
      \u043F\u043E\u0434\u0445\u043E\u0434\u0438 \u0431\u043B\u0438\u0436\u0435,
      \u043D\u0435 \u0448\u0442\u0435\u0448\u043D\u044F\u0439\u0448\u044F. \u0422\u044B
      \u043E\u0442\u043A\u0443\u0434\u0430 \u0442\u0430\u043A\u043E\u0439 \u0432\u0436\u044F\u043B\u0448\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 23575386567692288
    m_Localized: "\u042F \u043D\u0435 \u043F\u043E\u043C\u043D\u044E. \u041F\u0440\u043E\u0441\u043D\u0443\u043B\u0441\u044F
      \u043D\u0430 \u043F\u043B\u044F\u0436\u0435, \u0432\u0435\u0441\u044C \u0432
      \u0432\u043E\u0434\u043E\u0440\u043E\u0441\u043B\u044F\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 23575386567692289
    m_Localized: "\u0422\u0430\u043A \u0432\u043E\u0442 \u043E\u0442\u043A\u0443\u0434\u0430
      \u0448\u0442\u043E\u043B\u044C\u043A\u043E \u043C\u0443\u0448\u043E\u0440\u0430
      \u0432\u044B\u043D\u0435\u0448\u043B\u043E \u043D\u0430 \u0431\u0435\u0440\u0435\u0433!
      \u041F\u043E\u0445\u043E\u0436\u0435 \u0442\u0432\u043E\u0435\u043C\u0443 \u043A\u043E\u0440\u0430\u0431\u043B\u044E
      \u043A\u043E\u043D\u0435\u0448!"
    m_Metadata:
      m_Items: []
  - m_Id: 23575386571886592
    m_Localized: "\u041F\u043E\u0445\u043E\u0436\u0435 \u043D\u0430 \u0442\u043E...
      \u041A\u0430\u043A \u043C\u043D\u0435 \u043E\u0442\u0441\u044E\u0434\u0430
      \u0432\u044B\u0431\u0440\u0430\u0442\u044C\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 23575386571886593
    m_Localized: "\u041D\u0435 \u0436\u043D\u0430\u044E, \u043D\u0438\u043A\u043E\u0433\u0434\u0430
      \u043D\u0435 \u0434\u0443\u043C\u0430\u043B \u043E\u0431 \u044D\u0442\u043E\u043C.
      \u041D\u043E \u043C\u043E\u0436\u0435\u0448\u044C \u0448\u043F\u0440\u043E\u0441\u0438\u0442\u044C
      \u041A\u0430\u043F\u0438\u0442\u0430\u043D\u0430 \u041A\u043B\u0430\u0446\u0430.
      \u041E\u043D \u043D\u0430 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u043F\u043E\u043B\u043E\u0436\u043D\u043E\u0439
      \u0448\u0442\u043E\u0440\u043E\u043D\u0435 \u043E\u0448\u0442\u0440\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 23575386571886594
    m_Localized: "\u0422\u043E\u043B\u044C\u043A\u043E \u0442\u0430\u043A \u0442\u044B
      \u0442\u0443\u0434\u0430 \u043D\u0435 \u043F\u043E\u043F\u0430\u0434\u0451\u0448\u044C.
      \u0416\u0430\u0440\u043E\u0448\u043B\u0438 \u043F\u0440\u0435\u0433\u0440\u0430\u0436\u0434\u0430\u044E\u0442
      \u043F\u0443\u0442\u044C, \u0431\u0435\u0436 \u0448\u0430\u0431\u043B\u0438
      \u043D\u0438\u043A\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 23575386571886595
    m_Localized: "\u0418 \u0433\u0434\u0435 \u043C\u043D\u0435 \u0435\u0451 \u0434\u043E\u0441\u0442\u0430\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 23575386571886596
    m_Localized: "\u041C\u043E\u0436\u0435\u0448\u044C \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0447\u044C
      \u041D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u041A\u043E\u0440\u0430\u0431\u043B\u044C,
      \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u0443\u0434\u0430 \u0442\u043E\u0436\u0435
      \u043F\u0440\u043E\u0448\u0442\u043E \u0442\u0430\u043A \u043D\u0435 \u043F\u043E\u043F\u0430\u0434\u0451\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 23575386571886597
    m_Localized: "\u041D\u0443\u0436\u0435\u043D \u043A\u043B\u044E\u0447. \u0418
      \u043F\u043E \u0448\u0448\u0430\u0448\u043B\u0438\u0432\u043E\u0439 \u0448\u043B\u0443\u0447\u0430\u0439\u043D\u043E\u0448\u0442\u0438,
      \u044F \u043C\u043E\u0433\u0443 \u0442\u0435\u0431\u0435 \u0435\u0433\u043E
      \u043F\u0440\u043E\u0434\u0430\u0447\u044C. \u0428\u0430\u043C \u044F \u0442\u0443\u0434\u0430
      \u0432\u0448\u0435 \u0440\u0430\u0432\u043D\u043E \u043D\u0435 \u043F\u043E\u0439\u0434\u0443
      - \u0442\u0430\u043C \u043A\u0442\u043E-\u0442\u043E \u0440\u044B\u0447\u0438\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 23575386571886598
    m_Localized: "\u0412\u043F\u0440\u043E\u0448\u0435\u043C, \u0443 \u043C\u0435\u043D\u044F
      \u0435\u0448\u0442\u044C \u0432\u0435\u0448\u0448\u0438 \u043D\u0430 \u043B\u044E\u0431\u043E\u0439
      \u0432\u043A\u0443\u0448 - \u0440\u0435\u0436\u0443\u0448\u0438\u0435, \u043A\u043B\u044E\u044E\u0448\u0438\u0435
      \u0438 \u0442\u0435, \u043E \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043B\u0443\u0448\u0435
      \u043D\u0435 \u0448\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 23575386571886599
    m_Localized: "\u041F\u043E\u043A\u0430\u0436\u0438 \u0447\u0442\u043E \u0443
      \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 23575386571886600
    m_Localized: "\u0428 \u0442\u043E\u0431\u043E\u0439 \u043F\u0440\u0438\u044F\u0442\u043D\u043E
      \u0432\u0435\u0448\u0442\u0438 \u0434\u0435\u043B\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 23575386571886601
    m_Localized: "\u041D\u0443 \u0448\u0442\u043E\u0448. \u0416\u0430\u0445\u043E\u0434\u0438
      \u043A\u0430\u043A \u043D\u0430\u0434\u0443\u043C\u0430\u0435\u0448\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 23575386571886602
    m_Localized: "\u041D\u0443 \u0438 \u043A\u0430\u043A \u0445\u043E\u0448\u0448\u044C,
      \u0448\u0443\u0445\u043E\u043F\u0443\u0442\u043D\u044B\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 23575386571886603
    m_Localized: "\u0425\u043E\u0447\u0435\u0448\u044C \u0433\u043B\u044F\u043D\u0443\u0447\u044C
      \u043D\u0430 \u0442\u043E\u0432\u0430\u0440\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 23575386571886604
    m_Localized: "\u041A\u0430\u043A\u043E\u0439 \u043E\u0448\u0442\u0440\u044B\u0439
      \u043A\u043B\u0438\u043D\u043E\u043A! \u0428\u0442\u0430\u0432\u043B\u044E
      \u0448\u0432\u043E\u0439 \u0445\u0432\u043E\u0448\u0442 - \u0438\u043C \u0442\u044B
      \u0448\u043C\u043E\u0436\u0435\u0448\u044C \u043F\u0440\u043E\u0431\u0440\u0430\u0447\u0448\u0430
      \u0447\u0435\u0440\u0435\u0436 \u043B\u044E\u0431\u044B\u0435 \u0436\u0430\u0440\u043E\u0448\u043B\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 23575386571886605
    m_Localized: "\u042D\u0439, \u0441\u0443\u0445\u043E\u043F\u0443\u0442\u043D\u044B\u0439!
      \u0418\u0449\u0435\u0448\u044C \u043A\u043E\u0440\u0430\u0431\u043B\u044C \u0438\u043B\u0438
      \u043F\u0440\u043E\u0441\u0442\u043E \u043B\u044E\u0431\u0443\u0435\u0448\u044C\u0441\u044F
      \u043C\u043E\u0438\u043C\u0438 \u043F\u0430\u0440\u0443\u0441\u0430\u043C\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 23575386571886607
    m_Localized: "\u041E\u0445\u043E\u0442\u043D\u043E \u0431\u044B \u043F\u043E\u043C\u043E\u0433.
      \u042F \u0438 \u0441\u0430\u043C \u043D\u0435 \u043F\u0440\u043E\u0447\u044C
      \u0441\u043D\u043E\u0432\u0430 \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442,
      \u0434\u0430 \u043E\u0441\u0442\u0440\u043E\u0432 \u043D\u0430\u0441 \u043D\u0435
      \u043E\u0442\u043F\u0443\u0441\u043A\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 23575386571886608
    m_Localized: "\u041A\u0430\u0436\u0434\u044B\u0439 \u043A\u043E\u0440\u0430\u0431\u043B\u044C,
      \u0447\u0442\u043E \u0443\u0445\u043E\u0434\u0438\u0442 \u0432 \u043C\u043E\u0440\u0435,
      \u043A \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0443 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u0441\u044E\u0434\u0430. \u0422\u0435 \u0436\u0435 \u0441\u043A\u0430\u043B\u044B,
      \u0442\u043E\u0442 \u0436\u0435 \u0431\u0435\u0440\u0435\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 23575386571886609
    m_Localized: "\u041C\u043E\u0439 \u0434\u0435\u0434 \u0433\u043E\u0432\u043E\u0440\u0438\u043B:
      \u0432 \u0441\u0435\u0440\u0434\u0446\u0435 \u043E\u0441\u0442\u0440\u043E\u0432\u0430
      \u043B\u0435\u0436\u0438\u0442 \u0417\u043E\u043B\u043E\u0442\u043E\u0439 \u0427\u0435\u0440\u0435\u043F.
      \u041E\u043D \u0438 \u0434\u0435\u0440\u0436\u0438\u0442 \u043D\u0430\u0441
      \u043D\u0430 \u043F\u0440\u0438\u0432\u044F\u0437\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 23575386571886610
    m_Localized: "\u041F\u0440\u0438\u043D\u0435\u0441\u0438 \u043C\u043D\u0435 \u0427\u0435\u0440\u0435\u043F,
      \u0438 \u044F \u043E\u0442\u0432\u0435\u0437\u0443 \u0442\u0435\u0431\u044F
      \u0445\u043E\u0442\u044C \u043A \u0447\u0451\u0440\u0442\u0443 \u043D\u0430
      \u0440\u043E\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 23575386571886611
    m_Localized: "\u0411\u0435\u0437 \u0417\u043E\u043B\u043E\u0442\u043E\u0433\u043E
      \u0427\u0435\u0440\u0435\u043F\u0430 \u043C\u043E\u0440\u0435 \u0441\u043D\u043E\u0432\u0430
      \u0432\u044B\u043F\u043B\u044E\u043D\u0435\u0442 \u043D\u0430\u0441 \u043D\u0430
      \u044D\u0442\u043E\u0442 \u0431\u0435\u0440\u0435\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 23575386571886612
    m_Localized: "\u041F\u0440\u0438\u043D\u0435\u0441\u0438 \u0435\u0433\u043E \u043C\u043D\u0435,
      \u0438 \u043C\u043E\u0439 \u043A\u043E\u0440\u0430\u0431\u043B\u044C \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442
      \u0442\u0435\u0431\u044F \u043A\u0443\u0434\u0430 \u043F\u043E\u0436\u0435\u043B\u0430\u0435\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 23575386571886613
    m_Localized: "\u0427\u0442\u043E \u0443 \u0442\u0435\u0431\u044F \u0442\u0430\u043C?..
      \u041A\u043B\u044F\u043D\u0443\u0441\u044C \u043F\u0440\u0438\u043B\u0438\u0432\u043E\u043C,
      \u044D\u0442\u043E \u0417\u043E\u043B\u043E\u0442\u043E\u0439 \u0427\u0435\u0440\u0435\u043F!"
    m_Metadata:
      m_Items: []
  - m_Id: 23575386571886614
    m_Localized: "\u042F \u043D\u0430\u0448\u0451\u043B \u0435\u0433\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 23575386571886615
    m_Localized: "\u0425\u0430-\u0445\u0430! \u0417\u043D\u0430\u0447\u0438\u0442,
      \u0441\u0442\u0430\u0440\u0430\u044F \u043B\u0435\u0433\u0435\u043D\u0434\u0430
      \u043D\u0435 \u0432\u0440\u0430\u043B\u0430! \u042D\u0442\u043E\u0442 \u0431\u043B\u0435\u0441\u0442\u044F\u0449\u0438\u0439
      \u043C\u0435\u0440\u0437\u0430\u0432\u0435\u0446 \u0434\u0435\u0440\u0436\u0430\u043B
      \u043D\u0430\u0441 \u0442\u0443\u0442 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0434\u043E\u043B\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 23575386571886616
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u043C\u044B \u0441\u043C\u043E\u0436\u0435\u043C
      \u0443\u043F\u043B\u044B\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 23575386571886617
    m_Localized: "\u0415\u0449\u0451 \u043A\u0430\u043A \u0441\u043C\u043E\u0436\u0435\u043C!
      \u0412\u0435\u0442\u0435\u0440 \u0441\u0432\u0435\u0436\u0438\u0439, \u043C\u043E\u0440\u0435
      \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E, \u0430 \u043C\u043E\u0439
      \u043A\u043E\u0440\u0430\u0431\u043B\u044C \u0434\u0430\u0432\u043D\u043E \u0440\u0432\u0451\u0442\u0441\u044F
      \u0432 \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 23575386571886618
    m_Localized: "\u041F\u043E\u0434\u043D\u0438\u043C\u0430\u0439\u0441\u044F \u043D\u0430
      \u0431\u043E\u0440\u0442, \u0445\u0440\u0430\u0431\u0440\u0435\u0446. \u041A\u0430\u043F\u0438\u0442\u0430\u043D
      \u041A\u043B\u0430\u0446 \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442 \u0442\u0435\u0431\u044F
      \u043A\u0443\u0434\u0430 \u043F\u043E\u0436\u0435\u043B\u0430\u0435\u0448\u044C
      - \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043A\u0430\u0436\u0438 \u043A\u0443\u0434\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 23575386571886619
    m_Localized: "\u041F\u043E\u0434\u0430\u043B\u044C\u0448\u0435 \u043E\u0442\u0441\u044E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 23575386571886620
    m_Localized: "\u041E\u0442\u043B\u0438\u0447\u043D\u044B\u0439 \u043A\u0443\u0440\u0441!
      \u0414\u0435\u0440\u0436\u0438\u0441\u044C \u043A\u0440\u0435\u043F\u0447\u0435.
      \u041C\u044B \u043E\u0442\u043F\u043B\u044B\u0432\u0430\u0435\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 23586744164110336
    m_Localized: "\u041A\u0430\u043F\u0438\u0442\u0430\u043D \u041A\u043B\u0430\u0446"
    m_Metadata:
      m_Items: []
  - m_Id: 23588971280814080
    m_Localized: "\u0418 \u0442\u043E \u0438 \u0434\u0440\u0443\u0433\u043E\u0435!
      \u042F \u0445\u043E\u0447\u0443 \u0443\u043F\u043B\u044B\u0442\u044C \u0441
      \u043E\u0441\u0442\u0440\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 23588971285008384
    m_Localized: "\u041A\u0430\u043A \u044D\u0442\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 23588971285008385
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u044F \u043D\u0430\u0439\u0434\u0443
      \u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
