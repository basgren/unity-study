  m_TableData:
  - m_Id: 16244863356928
    m_Localized: 'Rikko                                       '
    m_Metadata:
      m_Items: []
  - m_Id: 16244863356929
    m_Localized: "\u0410hoy, trravelerrr... come closher, don't be shy now.                            "
    m_Metadata:
      m_Items: []
  - m_Id: 16244863356930
    m_Localized: I've got all shorts here - sharp thingsh, shtrange things, an' thingsh
      besht not ashked about.
    m_Metadata:
      m_Items: []
  - m_Id: 16244863356931
    m_Localized: 'Show me what you have                      '
    m_Metadata:
      m_Items: []
  - m_Id: 16244863356932
    m_Localized: 'Not today                                  '
    m_Metadata:
      m_Items: []
  - m_Id: 16244863356933
    m_Localized: Fiiine blade, very shiny, very pointy. 10 coinsh only!
    m_Metadata:
      m_Items: []
  - m_Id: 16244863356934
    m_Localized: 'I''ll take it                               '
    m_Metadata:
      m_Items: []
  - m_Id: 16244863356935
    m_Localized: 'No thanks                                  '
    m_Metadata:
      m_Items: []
  - m_Id: 16244863356936
    m_Localized: 'Exshellent choishe! That one bites almosht ash well ash I do.                   '
    m_Metadata:
      m_Items: []
  - m_Id: 16244863356937
    m_Localized: No coinsh? Hisssh... then no shtabby for you.
    m_Metadata:
      m_Items: []
  - m_Id: 16244863356938
    m_Localized: Suit yershelf, landwalker.
    m_Metadata:
      m_Items: []
  - m_Id: 1853243752665088
    m_Localized: Show me the goods
    m_Metadata:
      m_Items: []
  references:
    version: 2
