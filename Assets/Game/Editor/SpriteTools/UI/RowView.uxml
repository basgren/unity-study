<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <Style src="SpritePivotBatchWindow.uss" />
    <ui:VisualElement class="row-item">
        <ui:VisualElement name="row-name-line" class="row-line">
            <ui:Label text="Name" class="row-field-label" />
            <ui:VisualElement class="row-inputs">
                <ui:TextField name="row-name" class="row-name" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="row-pivot-line" class="row-line">
            <ui:Label text="Pivot" class="row-field-label" />
            <ui:VisualElement class="row-inputs">
                <uie:EnumField name="row-preset" class="row-input" />
                <uie:EnumField name="row-unit" class="row-input" />
                <uie:FloatField name="row-x" label="X" class="row-input" />
                <uie:FloatField name="row-y" label="Y" class="row-input" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
