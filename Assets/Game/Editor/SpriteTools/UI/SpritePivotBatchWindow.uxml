<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <Style src="SpritePivotBatchWindow.uss" />
    <ui:VisualElement class="root">
        <ui:Label name="mode-label" text="Mode" class="mode-banner" />

        <ui:HelpBox class="help" message-type="Info" text="Select sprite sub-assets to rename them as a numbered set, or select a whole texture to edit it row by row.&#10;Custom pivot values are measured from each sprite's bottom-left, in pixels (or 0-1 when Normalized)." />

        <ui:VisualElement class="section">
            <ui:Toggle name="change-pivot" text="Change Pivot" binding-path="changePivot" class="opt-toggle" />
            <ui:VisualElement name="each-row-own-pivot" class="indent">
                <ui:Toggle text="Each row with own pivot" binding-path="eachRowOwnPivot" class="opt-toggle" />
            </ui:VisualElement>
            <ui:Toggle name="change-names" text="Rename" binding-path="changeNames" class="opt-toggle" />
        </ui:VisualElement>

        <ui:VisualElement name="pivot-section" class="section">
            <uie:EnumField name="pivot-preset" label="Sheet Pivot" binding-path="pivotPreset" />
            <ui:VisualElement name="custom-pivot-row" class="row-line">
                <ui:Label text="Custom Pivot" class="prefix" />
                <uie:EnumField name="pivot-unit" binding-path="unitMode" class="unit" />
                <uie:FloatField name="pivot-x" label="X" binding-path="customPivot.x" class="xy" />
                <uie:FloatField name="pivot-y" label="Y" binding-path="customPivot.y" class="xy" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="numbering-section" class="section">
            <uie:IntegerField name="start-index" label="Start Index" binding-path="renameStartIndex" />
            <uie:IntegerField name="pad-width" label="Pad Width" binding-path="renamePadWidth" />
        </ui:VisualElement>

        <ui:VisualElement name="rows-section" class="section scroll-section">
            <ui:ScrollView name="rows-scroll" class="rows-scroll">
                <ui:VisualElement name="rows-container" />
            </ui:ScrollView>
        </ui:VisualElement>

        <ui:Button name="apply-button" text="Apply" class="apply" />
    </ui:VisualElement>
</ui:UXML>
