.root {
    padding: 8px;
    flex-grow: 1;
}

/* Checkbox on the left, caption on the right (via Toggle text, not the field label), and never
   compressed. */
.opt-toggle {
    flex-shrink: 0;
}

/* Fixed sections never compress; only the scroll sections absorb a short window. */
.section {
    margin-bottom: 6px;
    flex-shrink: 0;
}

/* Sections wrapping a ScrollView: allowed to shrink so the inner scroll area shows a scrollbar
   instead of the whole column overflowing and overlapping the sections below. */
.scroll-section {
    flex-shrink: 1;
    flex-grow: 1;
    min-height: 0;
}

.mode-banner {
    -unity-font-style: bold;
    margin-bottom: 4px;
    flex-shrink: 0;
}

.help {
    flex-shrink: 0;
}

.header {
    -unity-font-style: bold;
    margin-top: 2px;
    margin-bottom: 2px;
}

.indent {
    margin-left: 15px;
}

.row-line {
    flex-direction: row;
    align-items: center;
}

.prefix {
    width: 120px;
}

.unit {
    width: 90px;
}

.xy {
    width: 60px;
    margin-left: 2px;
}

.row-field-label {
    width: 40px;
    flex-shrink: 0;
}

.row-inputs {
    flex-direction: row;
    flex-grow: 1;
}

.row-name {
    flex-grow: 1;
}

.row-input {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 36px;
    margin-left: 2px;
}

/* The X / Y float fields ship a built-in label whose default min-width hides the number box;
   shrink it so the input stays visible when four controls share one row. */
.row-input .unity-base-field__label {
    min-width: 12px;
    width: 12px;
    margin-right: 2px;
}

.row-input .unity-base-field__input {
    min-width: 18px;
}

/* Big primary action pinned at the bottom of the window. */
.apply {
    margin-top: 6px;
    height: 32px;
    flex-shrink: 0;
}

/* The tree fills the remaining window height and scrolls internally when its content overflows. */
.rows-scroll {
    flex-grow: 1;
    min-height: 0;
    border-width: 1px;
    border-radius: 3px;
    border-color: var(--unity-colors-helpbox-border);
}

.preview-line {
    flex-direction: row;
    justify-content: space-between;
}

.preview-left {
    flex-grow: 1;
}

.preview-right {
    -unity-text-align: middle-right;
    color: var(--unity-colors-default-text);
}

/* Foldouts and the scroll content keep their natural height, so the surrounding ScrollView
   scrolls instead of vertically compressing the fields when many rows are expanded. */
.preview-foldout {
    margin-top: 1px;
    flex-shrink: 0;
}

.option-foldout {
    margin-top: 1px;
    flex-shrink: 0;
}

#rows-container {
    flex-shrink: 0;
}

/* Tree-style nesting: a wider indent plus a vertical guide line running down the children. */
.preview-foldout > .unity-foldout__content,
.option-foldout > .unity-foldout__content {
    margin-left: 16px;
    padding-left: 12px;
    border-left-width: 1px;
    border-left-color: var(--unity-colors-helpbox-border);
}
